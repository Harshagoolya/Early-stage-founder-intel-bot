# ── Required ───────────────────────────────────────────────────────────────────

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Tavily API key (free tier available) — https://tavily.com
TAVILY_API_KEY=tvly-...


# ── Channels (enable any combination) ─────────────────────────────────────────

# Discord — Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Slack — https://api.slack.com/apps > Create App > Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email via Resend (free tier: 3,000 emails/month) — https://resend.com
RESEND_API_KEY=re_...
EMAIL_FROM=Founder Intel <digest@yourdomain.com>
EMAIL_TO=you@example.com

# Telegram — create bot via @BotFather, add to channel as admin
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-100123456789
